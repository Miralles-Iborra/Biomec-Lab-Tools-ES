        "        nombres_hojas = libro.sheetnames\n",
        "        libro.close()\n",
        "\n",
        "        if hoja_rpe in nombres_hojas:\n",
        "            candidatos_rpe.append(\n",
        "                archivo\n",
        "            )\n",
        "        else:\n",
        "            candidatos_hrv.append(\n",
        "                archivo\n",
        "            )\n",
