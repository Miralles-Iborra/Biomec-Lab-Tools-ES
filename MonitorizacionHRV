        "# @title\n",
        "!pip -q install openpyxl ipywidgets\n",
        "\n",
        "import re\n",
        "import unicodedata\n",
        "from decimal import Decimal, ROUND_HALF_UP\n",
        "from datetime import datetime, date, time\n",
        "\n",
        "import numpy as np\n",
        "import pandas as pd\n",
        "import ipywidgets as widgets\n",
        "\n",
        "from IPython.display import display, clear_output\n",
        "from google.colab import files\n",
        "from openpyxl import load_workbook\n",
        "from openpyxl.styles import (\n",
        "    Font,\n",
        "    PatternFill,\n",
        "    Alignment,\n",
        "    Border,\n",
        "    Side,\n",
        ")\n",
        "from openpyxl.utils import get_column_letter\n",
        "\n",
        "\n",
        "# ================================================================\n",
        "# FUNCIONES AUXILIARES\n",
        "# ================================================================\n",
        "\n",
        "def normalizar(valor):\n",
        "    \"\"\"\n",
        "    Normaliza encabezados eliminando tildes, espacios y símbolos.\n",
        "    \"\"\"\n",
        "    if valor is None:\n",
        "        return \"\"\n",
        "\n",
        "    valor = unicodedata.normalize(\n",
        "        \"NFKD\",\n",
        "        str(valor),\n",
        "    )\n",
        "\n",
        "    valor = \"\".join(\n",
        "        caracter\n",
        "        for caracter in valor\n",
        "        if not unicodedata.combining(caracter)\n",
        "    )\n",
        "\n",
        "    return re.sub(\n",
        "        r\"[^A-Z0-9]\",\n",
        "        \"\",\n",
        "        valor.upper(),\n",
        "    )\n",
        "\n",
        "\n",
        "def esta_vacio(valor):\n",
        "    try:\n",
        "        return valor is None or pd.isna(valor)\n",
        "    except Exception:\n",
        "        return valor is None\n",
        "\n",
        "\n",
        "def convertir_fecha(valor):\n",
        "    \"\"\"\n",
        "    Convierte fechas de Excel, pandas o texto a datetime.date.\n",
        "    \"\"\"\n",
        "    if esta_vacio(valor):\n",
        "        return None\n",
        "\n",
        "    if isinstance(valor, pd.Timestamp):\n",
        "        return valor.date()\n",
        "\n",
        "    if isinstance(valor, datetime):\n",
        "        return valor.date()\n",
        "\n",
        "    if isinstance(valor, date):\n",
        "        return valor\n",
        "\n",
        "    if isinstance(\n",
        "        valor,\n",
        "        (\n",
        "            int,\n",
        "            float,\n",
        "            np.integer,\n",
        "            np.floating,\n",
        "        ),\n",
        "    ):\n",
        "        return (\n",
        "            pd.Timestamp(\"1899-12-30\")\n",
        "            + pd.to_timedelta(\n",
        "                float(valor),\n",
        "                unit=\"D\",\n",
        "            )\n",
        "        ).date()\n",
        "\n",
        "    valor = pd.to_datetime(\n",
        "        valor,\n",
        "        dayfirst=True,\n",
        "        errors=\"coerce\",\n",
        "    )\n",
        "\n",
        "    if pd.isna(valor):\n",
        "        return None\n",
        "\n",
        "    return valor.date()\n",
        "\n",
        "\n",
        "def convertir_a_segundos(valor):\n",
        "    \"\"\"\n",
        "    Convierte una hora o duración de Excel a segundos.\n",
        "    \"\"\"\n",
        "    if esta_vacio(valor):\n",
        "        return None\n",
        "\n",
        "    if isinstance(valor, pd.Timedelta):\n",
        "        return float(valor.total_seconds())\n",
        "\n",
        "    if isinstance(valor, datetime):\n",
        "        return (\n",
        "            valor.hour * 3600\n",
        "            + valor.minute * 60\n",
        "            + valor.second\n",
        "            + valor.microsecond / 1e6\n",
        "        )\n",
        "\n",
        "    if isinstance(valor, time):\n",
        "        return (\n",
        "            valor.hour * 3600\n",
        "            + valor.minute * 60\n",
        "            + valor.second\n",
        "            + valor.microsecond / 1e6\n",
        "        )\n",
        "\n",
        "    if isinstance(\n",
        "        valor,\n",
        "        (\n",
        "            int,\n",
        "            float,\n",
        "            np.integer,\n",
        "            np.floating,\n",
        "        ),\n",
        "    ):\n",
        "        valor = float(valor)\n",
        "\n",
        "        # Excel almacena las horas como fracciones de un día.\n",
        "        if abs(valor) < 2:\n",
        "            return valor * 86400\n",
        "\n",
        "        return valor\n",
        "\n",
        "    texto = str(valor).strip().replace(\",\", \".\")\n",
        "\n",
        "    if \":\" in texto:\n",
        "\n",
        "        partes = [\n",
        "            float(elemento)\n",
        "            for elemento in texto.split(\":\")\n",
        "        ]\n",
        "\n",
        "        if len(partes) == 3:\n",
        "            return (\n",
        "                partes[0] * 3600\n",
        "                + partes[1] * 60\n",
        "                + partes[2]\n",
        "            )\n",
        "\n",
        "        if len(partes) == 2:\n",
        "            return (\n",
        "                partes[0] * 60\n",
        "                + partes[1]\n",
        "            )\n",
        "\n",
        "    valor = float(texto)\n",
        "\n",
        "    if abs(valor) < 2:\n",
        "        return valor * 86400\n",
        "\n",
        "    return valor\n",
        "\n",
        "\n",
        "def redondear_umbral(valor):\n",
        "    \"\"\"\n",
        "    Aplica redondeo convencional:\n",
        "    148.5 se transforma en 149.\n",
        "    \"\"\"\n",
        "    return int(\n",
        "        Decimal(\n",
        "            str(float(valor))\n",
        "        ).quantize(\n",
        "            Decimal(\"1\"),\n",
        "            rounding=ROUND_HALF_UP,\n",
        "        )\n",
        "    )\n",
        "\n",
        "\n",
        "def segundos_a_hms(valor):\n",
        "    \"\"\"\n",
        "    Convierte segundos a HH:MM:SS.\n",
        "    \"\"\"\n",
        "    if valor is None or pd.isna(valor):\n",
        "        return \"\"\n",
        "\n",
        "    valor = max(\n",
        "        0,\n",
        "        int(round(float(valor))),\n",
        "    )\n",
        "\n",
        "    horas, resto = divmod(\n",
        "        valor,\n",
        "        3600,\n",
        "    )\n",
        "\n",
        "    minutos, segundos = divmod(\n",
        "        resto,\n",
        "        60,\n",
        "    )\n",
        "\n",
        "    return (\n",
        "        f\"{horas:02d}:\"\n",
        "        f\"{minutos:02d}:\"\n",
        "        f\"{segundos:02d}\"\n",
        "    )\n",
        "\n",
        "\n",
        "def obtener_valor(\n",
        "    fila,\n",
        "    columnas,\n",
        "    *nombres,\n",
        "):\n",
        "    \"\"\"\n",
        "    Busca una variable en la fila RPE aceptando varias formas\n",
        "    posibles de escribir su encabezado.\n",
        "    \"\"\"\n",
        "    for nombre in nombres:\n",
        "\n",
        "        columna_original = columnas.get(\n",
        "            normalizar(nombre)\n",
        "        )\n",
        "\n",
        "        if columna_original is not None:\n",
        "\n",
        "            valor = fila[\n",
        "                columna_original\n",
        "            ]\n",
        "\n",
        "            if not esta_vacio(valor):\n",
        "                return valor\n",
        "\n",
        "    return None\n",
        "\n",
        "\n",
        "def nombre_hoja_seguro(\n",
        "    nombre,\n",
        "    existentes,\n",
        "):\n",
        "    \"\"\"\n",
        "    Genera un nombre de hoja válido y no repetido.\n",
        "    \"\"\"\n",
        "    nombre = re.sub(\n",
        "        r\"[\\[\\]\\*\\?/\\\\:]\",\n",
        "        \"_\",\n",
        "        str(nombre),\n",
        "    )\n",
        "\n",
        "    nombre = nombre[:31] or \"Sesion\"\n",
        "    nombre_base = nombre\n",
        "\n",
        "    contador = 2\n",
        "\n",
        "    while nombre in existentes:\n",
        "\n",
        "        sufijo = f\"_{contador}\"\n",
        "\n",
        "        nombre = (\n",
        "            nombre_base[\n",
        "                :31 - len(sufijo)\n",
        "            ]\n",
        "            + sufijo\n",
        "        )\n",
        "\n",
        "        contador += 1\n",
        "\n",
        "    return nombre\n",
        "\n",
        "\n",
        "# ================================================================\n",
        "# LECTURA DE LAS HOJAS HRV\n",
        "# ================================================================\n",
        "\n",
        "def leer_hoja_hrv(\n",
        "    ruta,\n",
        "    hoja,\n",
        "):\n",
        "    \"\"\"\n",
        "    Lee una hoja del Excel de HRV.\n",
        "\n",
        "    Devuelve:\n",
        "    - fecha de la sesión;\n",
        "    - tiempo en segundos;\n",
        "    - frecuencia cardiaca;\n",
        "    - periodo de muestreo;\n",
        "    - inicio y final del registro.\n",
        "    \"\"\"\n",
        "\n",
        "    datos_brutos = pd.read_excel(\n",
        "        ruta,\n",
        "        sheet_name=hoja,\n",
        "        header=None,\n",
        "        dtype=object,\n",
        "    )\n",
        "\n",
        "    if datos_brutos.empty:\n",
        "        raise ValueError(\n",
        "            f\"La hoja {hoja} está vacía.\"\n",
        "        )\n",
        "\n",
        "    # ------------------------------------------------------------\n",
        "    # Extraer metadatos de las dos primeras filas\n",
        "    # ------------------------------------------------------------\n",
        "\n",
        "    metadatos = {}\n",
        "\n",
        "    if len(datos_brutos) >= 2:\n",
        "\n",
        "        for encabezado, valor in zip(\n",
        "            datos_brutos.iloc[0].tolist(),\n",
        "            datos_brutos.iloc[1].tolist(),\n",
        "        ):\n",
        "\n",
        "            clave = normalizar(encabezado)\n",
        "\n",
        "            if clave:\n",
        "                metadatos[clave] = valor\n",
        "\n",
        "    fecha = convertir_fecha(\n",
        "        metadatos.get(\n",
        "            \"DATE\",\n",
        "            metadatos.get(\"FECHA\"),\n",
        "        )\n",
        "    )\n",
        "\n",
        "    # ------------------------------------------------------------\n",
        "    # Localizar la fila que contiene Time y HR (bpm)\n",
        "    # ------------------------------------------------------------\n",
        "\n",
        "    fila_encabezado = None\n",
        "    columna_tiempo = None\n",
        "    columna_hr = None\n",
        "\n",
        "    encabezados_tiempo = {\n",
        "        \"TIME\",\n",
        "        \"TIEMPO\",\n",
        "        \"ELAPSEDTIME\",\n",
        "        \"DURATION\",\n",
        "    }\n",
        "\n",
        "    encabezados_hr = {\n",
        "        \"HR\",\n",
        "        \"HRBPM\",\n",
        "        \"HEARTRATE\",\n",
        "        \"HEARTRATEBPM\",\n",
        "        \"FC\",\n",
        "        \"FCBPM\",\n",
        "    }\n",
        "\n",
        "    for numero_fila in range(\n",
        "        min(20, len(datos_brutos))\n",
        "    ):\n",
        "\n",
        "        fila_normalizada = [\n",
        "            normalizar(valor)\n",
        "            for valor\n",
        "            in datos_brutos.iloc[\n",
        "                numero_fila\n",
        "            ].tolist()\n",
        "        ]\n",
        "\n",
        "        columnas_tiempo = [\n",
        "            posicion\n",
        "            for posicion, valor\n",
        "            in enumerate(fila_normalizada)\n",
        "            if valor in encabezados_tiempo\n",
        "        ]\n",
        "\n",
        "        columnas_hr = [\n",
        "            posicion\n",
        "            for posicion, valor\n",
        "            in enumerate(fila_normalizada)\n",
        "            if valor in encabezados_hr\n",
        "        ]\n",
        "\n",
        "        if columnas_tiempo and columnas_hr:\n",
        "\n",
        "            fila_encabezado = numero_fila\n",
        "            columna_tiempo = columnas_tiempo[0]\n",
        "            columna_hr = columnas_hr[0]\n",
        "\n",
        "            break\n",
        "\n",
        "    if fila_encabezado is None:\n",
        "\n",
        "        raise ValueError(\n",
        "            f\"No se localizaron las columnas \"\n",
        "            f\"Time y HR en la hoja {hoja}.\"\n",
        "        )\n",
        "\n",
        "    # ------------------------------------------------------------\n",
        "    # Extraer únicamente tiempo y frecuencia cardiaca\n",
        "    # ------------------------------------------------------------\n",
        "\n",
        "    datos = datos_brutos.iloc[\n",
        "        fila_encabezado + 1:,\n",
        "        [\n",
        "            columna_tiempo,\n",
        "            columna_hr,\n",
        "        ],\n",
        "    ].copy()\n",
        "\n",
        "    datos.columns = [\n",
        "        \"tiempo_original\",\n",
        "        \"hr\",\n",
        "    ]\n",
        "\n",
        "    # La columna Time contiene datetime.time, por lo que debe\n",
        "    # convertirse elemento a elemento mediante convertir_a_segundos().\n",
        "    datos[\"tiempo_s\"] = datos[\n",
        "        \"tiempo_original\"\n",
        "    ].apply(\n",
        "        convertir_a_segundos\n",
        "    )\n",
        "\n",
        "    datos[\"hr\"] = pd.to_numeric(\n",
        "        datos[\"hr\"],\n",
        "        errors=\"coerce\",\n",
        "    )\n",
        "\n",
        "    datos = datos[\n",
        "        [\n",
        "            \"tiempo_s\",\n",
        "            \"hr\",\n",
        "        ]\n",
        "    ].dropna()\n",
        "\n",
        "    datos = (\n",
        "        datos\n",
        "        .sort_values(\"tiempo_s\")\n",
        "        .drop_duplicates(\n",
        "            subset=\"tiempo_s\",\n",
        "            keep=\"first\",\n",
        "        )\n",
        "        .reset_index(drop=True)\n",
        "    )\n",
        "\n",
        "    if datos.empty:\n",
        "\n",
        "        raise ValueError(\n",
        "            f\"La hoja {hoja} no contiene \"\n",
        "            f\"datos válidos de FC después \"\n",
        "            f\"de convertir la columna Time.\"\n",
        "        )\n",
        "\n",
        "    datos[\"tiempo_s\"] = (\n",
        "        datos[\"tiempo_s\"]\n",
        "        .astype(float)\n",
        "        .round(6)\n",
        "    )\n",
        "\n",
        "    # ------------------------------------------------------------\n",
        "    # Calcular el periodo de muestreo\n",
        "    # ------------------------------------------------------------\n",
        "\n",
        "    diferencias = (\n",
        "        datos[\"tiempo_s\"]\n",
        "        .diff()\n",
        "    )\n",
        "\n",
        "    diferencias = diferencias[\n",
        "        diferencias > 0\n",
        "    ]\n",
        "\n",
        "    if len(diferencias):\n",
        "\n",
        "        periodo_muestreo = float(\n",
        "            diferencias.median()\n",
        "        )\n",
        "\n",
        "    else:\n",
        "\n",
        "        periodo_muestreo = 1.0\n",
        "\n",
        "    if (\n",
        "        abs(\n",
        "            periodo_muestreo\n",
        "            - round(periodo_muestreo)\n",
        "        )\n",
        "        < 1e-6\n",
        "    ):\n",
        "\n",
        "        periodo_muestreo = float(\n",
        "            round(periodo_muestreo)\n",
        "        )\n",
        "\n",
        "    return {\n",
        "        \"hoja\": hoja,\n",
        "        \"fecha\": fecha,\n",
        "\n",
        "        \"datos\": datos[\n",
        "            [\n",
        "                \"tiempo_s\",\n",
        "                \"hr\",\n",
        "            ]\n",
        "        ],\n",
        "\n",
        "        \"periodo\": periodo_muestreo,\n",
        "\n",
        "        \"inicio\": float(\n",
        "            datos[\"tiempo_s\"].min()\n",
        "        ),\n",
        "\n",
        "        \"fin\": float(\n",
        "            datos[\"tiempo_s\"].max()\n",
        "        ),\n",
        "\n",
        "        \"n_muestras\": int(\n",
        "            len(datos)\n",
        "        ),\n",
        "    }\n",
        "\n",
        "# ================================================================\n",
        "# LECTURA DE VALORACIÓN RPE\n",
        "# ================================================================\n",
        "\n",
        "def leer_valoracion_rpe(\n",
        "    ruta,\n",
        "    hoja_rpe,\n",
        "    sujeto,\n",
        "):\n",
        "    \"\"\"\n",
        "    Extrae HRMAX50, HRMAX75, RPE e intervalos de cada sesión.\n",
        "    \"\"\"\n",
        "    datos_rpe = pd.read_excel(\n",
        "        ruta,\n",
        "        sheet_name=hoja_rpe,\n",
        "        dtype=object,\n",
        "    )\n",
        "\n",
        "    columnas = {\n",
        "        normalizar(columna): columna\n",
        "        for columna\n",
        "        in datos_rpe.columns\n",
        "    }\n",
        "\n",
        "    columna_sujeto = columnas.get(\n",
        "        \"SUJETO\"\n",
        "    )\n",
        "\n",
        "    if columna_sujeto is None:\n",
        "        raise ValueError(\n",
        "            \"No existe la columna SUJETO \"\n",
        "            \"en la hoja RPE.\"\n",
        "        )\n",
        "\n",
        "    seleccion = datos_rpe[\n",
        "        datos_rpe[columna_sujeto]\n",
        "        .astype(str)\n",
        "        .str.strip()\n",
        "        .str.upper()\n",
        "        == sujeto.strip().upper()\n",
        "    ]\n",
        "\n",
        "    if seleccion.empty:\n",
        "\n",
        "        sujetos_disponibles = sorted(\n",
        "            datos_rpe[columna_sujeto]\n",
        "            .dropna()\n",
        "            .astype(str)\n",
        "            .str.strip()\n",
        "            .unique()\n",
        "            .tolist()\n",
        "        )\n",
        "\n",
        "        raise ValueError(\n",
        "            f\"No se encontró el sujeto {sujeto}. \"\n",
        "            f\"Sujetos disponibles: \"\n",
        "            f\"{sujetos_disponibles}\"\n",
        "        )\n",
        "\n",
        "    fila = seleccion.iloc[0]\n",
        "\n",
        "    hrmax50 = pd.to_numeric(\n",
        "        obtener_valor(\n",
        "            fila,\n",
        "            columnas,\n",
        "            \"HRMAX50\",\n",
        "        ),\n",
        "        errors=\"coerce\",\n",
        "    )\n",
        "\n",
        "    hrmax75 = pd.to_numeric(\n",
        "        obtener_valor(\n",
        "            fila,\n",
        "            columnas,\n",
        "            \"HRMAX75\",\n",
        "        ),\n",
        "        errors=\"coerce\",\n",
        "    )\n",
        "\n",
        "    if (\n",
        "        pd.isna(hrmax50)\n",
        "        or pd.isna(hrmax75)\n",
        "    ):\n",
        "        raise ValueError(\n",
        "            \"HRMAX50 y HRMAX75 deben \"\n",
        "            \"contener valores numéricos.\"\n",
        "        )\n",
        "\n",
        "    numeros_sesion = sorted(\n",
        "        {\n",
        "            int(coincidencia.group(1))\n",
        "            for columna\n",
        "            in datos_rpe.columns\n",
        "            if (\n",
        "                coincidencia\n",
        "                := re.fullmatch(\n",
        "                    r\"SESION(\\d+)\",\n",
        "                    normalizar(columna),\n",
        "                )\n",
        "            )\n",
        "        }\n",
        "    )\n",
        "\n",
        "    sesiones = []\n",
        "\n",
        "    for numero in numeros_sesion:\n",
        "\n",
        "        fecha = convertir_fecha(\n",
        "            obtener_valor(\n",
        "                fila,\n",
        "                columnas,\n",
        "                f\"SESION{numero}\",\n",
        "            )\n",
        "        )\n",
        "\n",
        "        if fecha is None:\n",
        "            continue\n",
        "\n",
        "        sesiones.append(\n",
        "            {\n",
        "                \"numero\": numero,\n",
        "                \"fecha\": fecha,\n",
        "\n",
        "                \"FUERZA\": {\n",
        "                    \"rpe\": obtener_valor(\n",
        "                        fila,\n",
        "                        columnas,\n",
        "                        f\"RPE_FUERZA_SESION{numero}\",\n",
        "                    ),\n",
        "                    \"inicio\": convertir_a_segundos(\n",
        "                        obtener_valor(\n",
        "                            fila,\n",
        "                            columnas,\n",
        "                            f\"TIEMPOini_FUERZA_SESION{numero}\",\n",
        "                        )\n",
        "                    ),\n",
        "                    \"fin\": convertir_a_segundos(\n",
        "                        obtener_valor(\n",
        "                            fila,\n",
        "                            columnas,\n",
        "                            f\"TIEMPOFIN_FUERZA_SESION{numero}\",\n",
        "                        )\n",
        "                    ),\n",
        "                },\n",
        "\n",
        "                \"FUNCIONAL\": {\n",
        "                    \"rpe\": obtener_valor(\n",
        "                        fila,\n",
        "                        columnas,\n",
        "                        f\"RPE_FUNCIONAL_SESION{numero}\",\n",
        "                    ),\n",
        "                    \"inicio\": convertir_a_segundos(\n",
        "                        obtener_valor(\n",
        "                            fila,\n",
        "                            columnas,\n",
        "                            f\"TIEMPOini_FUNCIONAL_SESION{numero}\",\n",
        "                        )\n",
        "                    ),\n",
        "                    \"fin\": convertir_a_segundos(\n",
        "                        obtener_valor(\n",
        "                            fila,\n",
        "                            columnas,\n",
        "                            f\"TIEMPOFIN_FUNCIONAL_SESION{numero}\",\n",
        "                        )\n",
        "                    ),\n",
        "                },\n",
        "\n",
        "                \"RESISTENCIA\": {\n",
        "                    \"rpe\": obtener_valor(\n",
        "                        fila,\n",
        "                        columnas,\n",
        "                        f\"RPE_RESIST_SESION{numero}\",\n",
        "                        f\"RPE_RESISTENCIA_SESION{numero}\",\n",
        "                    ),\n",
        "                    \"inicio\": convertir_a_segundos(\n",
        "                        obtener_valor(\n",
        "                            fila,\n",
        "                            columnas,\n",
        "                            f\"TIEMPOini_RESIT_SESION{numero}\",\n",
        "                            f\"TIEMPOini_RESIST_SESION{numero}\",\n",
        "                            f\"TIEMPOini_RESISTENCIA_SESION{numero}\",\n",
        "                        )\n",
        "                    ),\n",
        "                    \"fin\": convertir_a_segundos(\n",
        "                        obtener_valor(\n",
        "                            fila,\n",
        "                            columnas,\n",
        "                            f\"TIEMPOFIN_RESIST_SESION{numero}\",\n",
        "                            f\"TIEMPOFIN_RESISTENCIA_SESION{numero}\",\n",
        "                        )\n",
        "                    ),\n",
        "                },\n",
        "            }\n",
        "        )\n",
        "\n",
        "    if not sesiones:\n",
        "        raise ValueError(\n",
        "            \"No se encontraron sesiones \"\n",
        "            \"con fecha en la hoja RPE.\"\n",
        "        )\n",
        "\n",
        "    return {\n",
        "        \"hrmax50\": float(hrmax50),\n",
        "        \"hrmax75\": float(hrmax75),\n",
        "        \"sesiones\": sesiones,\n",
        "    }\n",
        "\n",
        "\n",
        "# ================================================================\n",
        "# CÁLCULO DE LAS ZONAS\n",
        "# ================================================================\n",
        "\n",
        "def calcular_zonas(\n",
        "    datos,\n",
        "    inicio,\n",
        "    fin,\n",
        "    hrmax,\n",
        "    periodo,\n",
        "    incluir_menores_60,\n",
        "    recortar_intervalos,\n",
        "    decimales_minutos,\n",
        "):\n",
        "    avisos = []\n",
        "\n",
        "    if inicio is None or fin is None:\n",
        "        return (\n",
        "            None,\n",
        "            [\"Falta el tiempo inicial o final.\"],\n",
        "        )\n",
        "\n",
        "    if fin < inicio:\n",
        "        return (\n",
        "            None,\n",
        "            [\n",
        "                \"El tiempo final es menor \"\n",
        "                \"que el inicial.\"\n",
        "            ],\n",
        "        )\n",
        "\n",
        "    inicio_usado = float(inicio)\n",
        "    fin_usado = float(fin)\n",
        "\n",
        "    minimo_registro = float(\n",
        "        datos[\"tiempo_s\"].min()\n",
        "    )\n",
        "\n",
        "    maximo_registro = float(\n",
        "        datos[\"tiempo_s\"].max()\n",
        "    )\n",
        "\n",
        "    if (\n",
        "        inicio_usado < minimo_registro\n",
        "        or fin_usado > maximo_registro\n",
        "    ):\n",
        "\n",
        "        if not recortar_intervalos:\n",
        "            return (\n",
        "                None,\n",
        "                [\n",
        "                    \"El intervalo queda fuera \"\n",
        "                    \"del registro de FC.\"\n",
        "                ],\n",
        "            )\n",
        "\n",
        "        inicio_usado = max(\n",
        "            inicio_usado,\n",
        "            minimo_registro,\n",
        "        )\n",
        "\n",
        "        fin_usado = min(\n",
        "            fin_usado,\n",
        "            maximo_registro,\n",
        "        )\n",
        "\n",
        "        avisos.append(\n",
        "            \"Intervalo recortado al periodo \"\n",
        "            \"disponible de FC.\"\n",
        "        )\n",
        "\n",
        "    if fin_usado < inicio_usado:\n",
        "        return (\n",
        "            None,\n",
        "            avisos\n",
        "            + [\n",
        "                \"El intervalo no se solapa \"\n",
        "                \"con el registro de FC.\"\n",
        "            ],\n",
        "        )\n",
        "\n",
        "    frecuencias = datos.loc[\n",
        "        (\n",
        "            datos[\"tiempo_s\"]\n",
        "            >= inicio_usado - 1e-6\n",
        "        )\n",
        "        & (\n",
        "            datos[\"tiempo_s\"]\n",
        "            <= fin_usado + 1e-6\n",
        "        ),\n",
        "        \"hr\",\n",
        "    ].to_numpy(\n",
        "        dtype=float\n",
        "    )\n",
        "\n",
        "    if len(frecuencias) == 0:\n",
        "        return (\n",
        "            None,\n",
        "            avisos\n",
        "            + [\n",
        "                \"No hay muestras de FC \"\n",
        "                \"en el intervalo.\"\n",
        "            ],\n",
        "        )\n",
        "\n",
        "    umbrales = {\n",
        "        porcentaje: redondear_umbral(\n",
        "            hrmax\n",
        "            * porcentaje\n",
        "            / 100\n",
        "        )\n",
        "        for porcentaje in [\n",
        "            60,\n",
        "            70,\n",
        "            80,\n",
        "            90,\n",
        "            100,\n",
        "            110,\n",
        "        ]\n",
        "    }\n",
        "\n",
        "    if incluir_menores_60:\n",
        "\n",
        "        mascara_z1 = (\n",
        "            frecuencias\n",
        "            <= umbrales[70]\n",
        "        )\n",
        "\n",
        "        segundos_bajo_60 = 0\n",
        "\n",
        "    else:\n",
        "\n",
        "        mascara_z1 = (\n",
        "            (\n",
        "                frecuencias\n",
        "                >= umbrales[60]\n",
        "            )\n",
        "            & (\n",
        "                frecuencias\n",
        "                <= umbrales[70]\n",
        "            )\n",
        "        )\n",
        "\n",
        "        segundos_bajo_60 = (\n",
        "            float(\n",
        "                np.sum(\n",
        "                    frecuencias\n",
        "                    < umbrales[60]\n",
        "                )\n",
        "            )\n",
        "            * periodo\n",
        "        )\n",
        "\n",
        "    mascaras = [\n",
        "        mascara_z1,\n",
        "\n",
        "        (\n",
        "            (\n",
        "                frecuencias\n",
        "                >= umbrales[70]\n",
        "            )\n",
        "            & (\n",
        "                frecuencias\n",
        "                < umbrales[80]\n",
        "            )\n",
        "        ),\n",
        "\n",
        "        (\n",
        "            (\n",
        "                frecuencias\n",
        "                >= umbrales[80]\n",
        "            )\n",
        "            & (\n",
        "                frecuencias\n",
        "                < umbrales[90]\n",
        "            )\n",
        "        ),\n",
        "\n",
        "        (\n",
        "            (\n",
        "                frecuencias\n",
        "                >= umbrales[90]\n",
        "            )\n",
        "            & (\n",
        "                frecuencias\n",
        "                < umbrales[100]\n",
        "            )\n",
        "        ),\n",
        "\n",
        "        (\n",
        "            (\n",
        "                frecuencias\n",
        "                >= umbrales[100]\n",
        "            )\n",
        "            & (\n",
        "                frecuencias\n",
        "                < umbrales[110]\n",
        "            )\n",
        "        ),\n",
        "\n",
        "        frecuencias >= umbrales[110],\n",
        "    ]\n",
        "\n",
        "    segundos = [\n",
        "        float(\n",
        "            np.sum(mascara)\n",
        "        )\n",
        "        * periodo\n",
        "        for mascara in mascaras\n",
        "    ]\n",
        "\n",
        "    segundos_limpios = [\n",
        "        (\n",
        "            int(round(valor))\n",
        "            if (\n",
        "                abs(\n",
        "                    valor\n",
        "                    - round(valor)\n",
        "                )\n",
        "                < 1e-8\n",
        "            )\n",
        "            else round(valor, 3)\n",
        "        )\n",
        "        for valor in segundos\n",
        "    ]\n",
        "\n",
        "    minutos = [\n",
        "        round(\n",
        "            valor / 60,\n",
        "            decimales_minutos,\n",
        "        )\n",
        "        for valor in segundos\n",
        "    ]\n",
        "\n",
        "    return (\n",
        "        {\n",
        "            \"umbrales\": umbrales,\n",
        "            \"segundos\": segundos_limpios,\n",
        "            \"minutos\": minutos,\n",
        "            \"inicio_usado\": inicio_usado,\n",
        "            \"fin_usado\": fin_usado,\n",
        "            \"muestras\": len(frecuencias),\n",
        "            \"bajo60\": segundos_bajo_60,\n",
        "        },\n",
        "        avisos,\n",
        "    )\n",
        "\n",
        "\n",
        "# ================================================================\n",
        "# EMPAREJAMIENTO DE SESIONES\n",
        "# ================================================================\n",
        "\n",
        "def emparejar_sesion(\n",
        "    sesion_rpe,\n",
        "    sesiones_hrv,\n",
        "    hojas_usadas,\n",
        "    modo,\n",
        "    permitir_fallback,\n",
        "):\n",
        "    disponibles = [\n",
        "        sesion\n",
        "        for sesion in sesiones_hrv\n",
        "        if sesion[\"hoja\"] not in hojas_usadas\n",
        "    ]\n",
        "\n",
        "    if modo in {\n",
        "        \"Fecha exacta\",\n",
        "        \"Automático\",\n",
        "    }:\n",
        "\n",
        "        candidatos = [\n",
        "            sesion\n",
        "            for sesion in disponibles\n",
        "            if (\n",
        "                sesion[\"fecha\"]\n",
        "                == sesion_rpe[\"fecha\"]\n",
        "            )\n",
        "        ]\n",
        "\n",
        "        if len(candidatos) == 1:\n",
        "            return (\n",
        "                candidatos[0],\n",
        "                \"fecha\",\n",
        "                \"\",\n",
        "            )\n",
        "\n",
        "        if (\n",
        "            modo == \"Fecha exacta\"\n",
        "            or not permitir_fallback\n",
        "        ):\n",
        "            return (\n",
        "                None,\n",
        "                \"fecha\",\n",
        "                \"No existe una hoja HRV \"\n",
        "                \"con la misma fecha.\",\n",
        "            )\n",
        "\n",
        "    if modo in {\n",
        "        \"Orden de las hojas\",\n",
        "        \"Automático\",\n",
        "    }:\n",
        "\n",
        "        if disponibles:\n",
        "\n",
        "            sesion_hrv = disponibles[0]\n",
        "            aviso = \"\"\n",
        "\n",
        "            if (\n",
        "                sesion_hrv[\"fecha\"]\n",
        "                != sesion_rpe[\"fecha\"]\n",
        "            ):\n",
        "                aviso = (\n",
        "                    \"Emparejada por orden pese \"\n",
        "                    \"a fechas distintas: \"\n",
        "                    f\"RPE {sesion_rpe['fecha']} / \"\n",
        "                    f\"HRV {sesion_hrv['fecha']}.\"\n",
        "                )\n",
        "\n",
        "            return (\n",
        "                sesion_hrv,\n",
        "                \"orden\",\n",
        "                aviso,\n",
        "            )\n",
        "\n",
        "    return (\n",
        "        None,\n",
        "        modo,\n",
        "        \"No se pudo emparejar la sesión.\",\n",
        "    )\n",
        "\n",
        "\n",
        "# ================================================================\n",
        "# FORMATO DEL EXCEL\n",
        "# ================================================================\n",
        "\n",
        "def formatear_excel(ruta):\n",
        "    libro = load_workbook(ruta)\n",
        "\n",
        "    azul = \"1F4E78\"\n",
        "    verde = \"548235\"\n",
        "    azul_claro = \"D9EAF7\"\n",
        "    blanco = \"FFFFFF\"\n",
        "    rojo_claro = \"FCE4D6\"\n",
        "\n",
        "    borde = Border(\n",
        "        left=Side(\n",
        "            style=\"thin\",\n",
        "            color=\"A6A6A6\",\n",
        "        ),\n",
        "        right=Side(\n",
        "            style=\"thin\",\n",
        "            color=\"A6A6A6\",\n",
        "        ),\n",
        "        top=Side(\n",
        "            style=\"thin\",\n",
        "            color=\"A6A6A6\",\n",
        "        ),\n",
        "        bottom=Side(\n",
        "            style=\"thin\",\n",
        "            color=\"A6A6A6\",\n",
        "        ),\n",
        "    )\n",
        "\n",
        "    for hoja in libro.worksheets:\n",
        "\n",
        "        hoja.sheet_view.showGridLines = False\n",
        "\n",
        "        if hoja.title == \"CONTROL\":\n",
        "            hoja.freeze_panes = \"A2\"\n",
        "        else:\n",
        "            hoja.freeze_panes = \"A3\"\n",
        "\n",
        "        for fila in hoja.iter_rows():\n",
        "\n",
        "            for celda in fila:\n",
        "\n",
        "                celda.border = borde\n",
        "\n",
        "                celda.alignment = Alignment(\n",
        "                    horizontal=\"center\",\n",
        "                    vertical=\"center\",\n",
        "                    wrap_text=True,\n",
        "                )\n",
        "\n",
        "        for celda in hoja[1]:\n",
        "\n",
        "            celda.font = Font(\n",
        "                bold=True,\n",
        "                color=blanco,\n",
        "            )\n",
        "\n",
        "            celda.fill = PatternFill(\n",
        "                \"solid\",\n",
        "                fgColor=azul,\n",
        "            )\n",
        "\n",
        "        if hoja.title != \"CONTROL\":\n",
        "\n",
        "            for numero_fila in range(\n",
        "                1,\n",
        "                hoja.max_row + 1,\n",
        "            ):\n",
        "\n",
        "                valor = hoja.cell(\n",
        "                    numero_fila,\n",
        "                    1,\n",
        "                ).value\n",
        "\n",
        "                if (\n",
        "                    isinstance(valor, str)\n",
        "                    and valor.startswith(\n",
        "                        \"PARTE DE\"\n",
        "                    )\n",
        "                ):\n",
        "\n",
        "                    hoja.merge_cells(\n",
        "                        start_row=numero_fila,\n",
        "                        start_column=1,\n",
        "                        end_row=numero_fila,\n",
        "                        end_column=9,\n",
        "                    )\n",
        "\n",
        "                    hoja.cell(\n",
        "                        numero_fila,\n",
        "                        1,\n",
        "                    ).font = Font(\n",
        "                        bold=True,\n",
        "                        color=blanco,\n",
        "                    )\n",
        "\n",
        "                    hoja.cell(\n",
        "                        numero_fila,\n",
        "                        1,\n",
        "                    ).fill = PatternFill(\n",
        "                        \"solid\",\n",
        "                        fgColor=verde,\n",
        "                    )\n",
        "\n",
        "                    for columna in range(\n",
        "                        1,\n",
        "                        10,\n",
        "                    ):\n",
        "\n",
        "                        hoja.cell(\n",
        "                            numero_fila + 1,\n",
        "                            columna,\n",
        "                        ).font = Font(\n",
        "                            bold=True\n",
        "                        )\n",
        "\n",
        "                        hoja.cell(\n",
        "                            numero_fila + 1,\n",
        "                            columna,\n",
        "                        ).fill = PatternFill(\n",
        "                            \"solid\",\n",
        "                            fgColor=azul_claro,\n",
        "                        )\n",
        "\n",
        "        else:\n",
        "\n",
        "            columna_avisos = None\n",
        "\n",
        "            for celda in hoja[1]:\n",
        "\n",
        "                if celda.value == \"Avisos\":\n",
        "                    columna_avisos = celda.column\n",
        "                    break\n",
        "\n",
        "            if columna_avisos:\n",
        "\n",
        "                for numero_fila in range(\n",
        "                    2,\n",
        "                    hoja.max_row + 1,\n",
        "                ):\n",
        "\n",
        "                    if hoja.cell(\n",
        "                        numero_fila,\n",
        "                        columna_avisos,\n",
        "                    ).value:\n",
        "\n",
        "                        for columna in range(\n",
        "                            1,\n",
        "                            hoja.max_column + 1,\n",
        "                        ):\n",
        "\n",
        "                            hoja.cell(\n",
        "                                numero_fila,\n",
        "                                columna,\n",
        "                            ).fill = PatternFill(\n",
        "                                \"solid\",\n",
        "                                fgColor=rojo_claro,\n",
        "                            )\n",
        "\n",
        "        for numero_columna in range(\n",
        "            1,\n",
        "            hoja.max_column + 1,\n",
        "        ):\n",
        "\n",
        "            longitudes = [\n",
        "                (\n",
        "                    len(\n",
        "                        str(\n",
        "                            hoja.cell(\n",
        "                                numero_fila,\n",
        "                                numero_columna,\n",
        "                            ).value\n",
        "                        )\n",
        "                    )\n",
        "                    if (\n",
        "                        hoja.cell(\n",
        "                            numero_fila,\n",
        "                            numero_columna,\n",
        "                        ).value\n",
        "                        is not None\n",
        "                    )\n",
        "                    else 0\n",
        "                )\n",
        "                for numero_fila in range(\n",
        "                    1,\n",
        "                    hoja.max_row + 1,\n",
        "                )\n",
        "            ]\n",
        "\n",
        "            anchura = min(\n",
        "                max(\n",
        "                    longitudes + [10]\n",
        "                )\n",
        "                + 2,\n",
        "                40,\n",
        "            )\n",
        "\n",
        "            hoja.column_dimensions[\n",
        "                get_column_letter(\n",
        "                    numero_columna\n",
        "                )\n",
        "            ].width = anchura\n",
        "\n",
        "    libro.save(ruta)\n",
        "\n",
        "\n",
        "# ================================================================\n",
        "# GENERACIÓN DEL EXCEL\n",
        "# ================================================================\n",
        "\n",
        "def generar_excel(\n",
        "    archivo_hrv,\n",
        "    archivo_rpe,\n",
        "    sujeto,\n",
        "    hoja_rpe,\n",
        "    incluir_menores_60,\n",
        "    recortar_intervalos,\n",
        "    decimales_minutos,\n",
        "    modo_emparejamiento,\n",
        "    permitir_fallback,\n",
        "    nombre_salida,\n",
        "):\n",
        "    informacion_rpe = leer_valoracion_rpe(\n",
        "        ruta=archivo_rpe,\n",
        "        hoja_rpe=hoja_rpe,\n",
        "        sujeto=sujeto,\n",
        "    )\n",
        "\n",
        "    libro_hrv = pd.ExcelFile(\n",
        "        archivo_hrv\n",
        "    )\n",
        "\n",
        "    sesiones_hrv = [\n",
        "        leer_hoja_hrv(\n",
        "            ruta=archivo_hrv,\n",
        "            hoja=nombre_hoja,\n",
        "        )\n",
        "        for nombre_hoja\n",
        "        in libro_hrv.sheet_names\n",
        "    ]\n",
        "\n",
        "    zonas = [\n",
        "        \"Z1\",\n",
        "        \"Z2\",\n",
        "        \"Z3\",\n",
        "        \"Z4\",\n",
        "        \"Z5\",\n",
        "        \"Z6\",\n",
        "    ]\n",
        "\n",
        "    rangos = [\n",
        "        \"60–70%\",\n",
        "        \"70–80%\",\n",
        "        \"80–90%\",\n",
        "        \"90–100%\",\n",
        "        \"100–110%\",\n",
        "        \">110%\",\n",
        "    ]\n",
        "\n",
        "    control = []\n",
        "    hojas_usadas = set()\n",
        "    nombres_generados = set()\n",
        "\n",
        "    if not nombre_salida.lower().endswith(\n",
        "        \".xlsx\"\n",
        "    ):\n",
        "        nombre_salida += \".xlsx\"\n",
        "\n",
        "    with pd.ExcelWriter(\n",
        "        nombre_salida,\n",
        "        engine=\"openpyxl\",\n",
        "    ) as escritor:\n",
        "\n",
        "        sesiones_ordenadas = sorted(\n",
        "            informacion_rpe[\"sesiones\"],\n",
        "            key=lambda elemento: elemento[\"numero\"],\n",
        "        )\n",
        "\n",
        "        for sesion_rpe in sesiones_ordenadas:\n",
        "\n",
        "            (\n",
        "                sesion_hrv,\n",
        "                metodo,\n",
        "                aviso_emparejamiento,\n",
        "            ) = emparejar_sesion(\n",
        "                sesion_rpe=sesion_rpe,\n",
        "                sesiones_hrv=sesiones_hrv,\n",
        "                hojas_usadas=hojas_usadas,\n",
        "                modo=modo_emparejamiento,\n",
        "                permitir_fallback=permitir_fallback,\n",
        "            )\n",
        "\n",
        "            if sesion_hrv is None:\n",
        "\n",
        "                control.append(\n",
        "                    {\n",
        "                        \"Sesión\": sesion_rpe[\"numero\"],\n",
        "                        \"Fecha RPE\": sesion_rpe[\"fecha\"],\n",
        "                        \"Hoja HRV\": \"\",\n",
        "                        \"Fecha HRV\": \"\",\n",
        "                        \"Método\": metodo,\n",
        "                        \"Parte\": \"\",\n",
        "                        \"Inicio solicitado\": \"\",\n",
        "                        \"Fin solicitado\": \"\",\n",
        "                        \"Inicio usado\": \"\",\n",
        "                        \"Fin usado\": \"\",\n",
        "                        \"Muestras\": \"\",\n",
        "                        \"Segundos Z1–Z6\": \"\",\n",
        "                        \"Segundos <60%\": \"\",\n",
        "                        \"Avisos\": aviso_emparejamiento,\n",
        "                    }\n",
        "                )\n",
        "\n",
        "                continue\n",
        "\n",
        "            hojas_usadas.add(\n",
        "                sesion_hrv[\"hoja\"]\n",
        "            )\n",
        "\n",
        "            nombre_hoja = nombre_hoja_seguro(\n",
        "                nombre=(\n",
        "                    f\"S{sesion_rpe['numero']}_\"\n",
        "                    f\"{sesion_hrv['hoja']}\"\n",
        "                ),\n",
        "                existentes=nombres_generados,\n",
        "            )\n",
        "\n",
        "            nombres_generados.add(\n",
        "                nombre_hoja\n",
        "            )\n",
        "\n",
        "            fila_inicio = 0\n",
        "\n",
        "            for parte in [\n",
        "                \"FUERZA\",\n",
        "                \"FUNCIONAL\",\n",
        "                \"RESISTENCIA\",\n",
        "            ]:\n",
        "\n",
        "                informacion_parte = (\n",
        "                    sesion_rpe[parte]\n",
        "                )\n",
        "\n",
        "                resultado_50, avisos_50 = calcular_zonas(\n",
        "                    datos=sesion_hrv[\"datos\"],\n",
        "                    inicio=informacion_parte[\"inicio\"],\n",
        "                    fin=informacion_parte[\"fin\"],\n",
        "                    hrmax=informacion_rpe[\"hrmax50\"],\n",
        "                    periodo=sesion_hrv[\"periodo\"],\n",
        "                    incluir_menores_60=incluir_menores_60,\n",
        "                    recortar_intervalos=recortar_intervalos,\n",
        "                    decimales_minutos=decimales_minutos,\n",
        "                )\n",
        "\n",
        "                resultado_75, avisos_75 = calcular_zonas(\n",
        "                    datos=sesion_hrv[\"datos\"],\n",
        "                    inicio=informacion_parte[\"inicio\"],\n",
        "                    fin=informacion_parte[\"fin\"],\n",
        "                    hrmax=informacion_rpe[\"hrmax75\"],\n",
        "                    periodo=sesion_hrv[\"periodo\"],\n",
        "                    incluir_menores_60=incluir_menores_60,\n",
        "                    recortar_intervalos=recortar_intervalos,\n",
        "                    decimales_minutos=decimales_minutos,\n",
        "                )\n",
        "\n",
        "                avisos = list(\n",
        "                    dict.fromkeys(\n",
        "                        [\n",
        "                            aviso\n",
        "                            for aviso in (\n",
        "                                [aviso_emparejamiento]\n",
        "                                + avisos_50\n",
        "                                + avisos_75\n",
        "                            )\n",
        "                            if aviso\n",
        "                        ]\n",
        "                    )\n",
        "                )\n",
        "\n",
        "                if (\n",
        "                    resultado_50 is None\n",
        "                    or resultado_75 is None\n",
        "                ):\n",
        "\n",
        "                    tabla = pd.DataFrame(\n",
        "                        {\n",
        "                            \"Aviso\": [\n",
        "                                \" | \".join(\n",
        "                                    avisos\n",
        "                                )\n",
        "                            ]\n",
        "                        }\n",
        "                    )\n",
        "\n",
        "                else:\n",
        "\n",
        "                    limites_50 = [\n",
        "                        resultado_50[\"umbrales\"][70],\n",
        "                        resultado_50[\"umbrales\"][80],\n",
        "                        resultado_50[\"umbrales\"][90],\n",
        "                        resultado_50[\"umbrales\"][100],\n",
        "                        resultado_50[\"umbrales\"][110],\n",
        "                        resultado_50[\"umbrales\"][110],\n",
        "                    ]\n",
        "\n",
        "                    limites_75 = [\n",
        "                        resultado_75[\"umbrales\"][70],\n",
        "                        resultado_75[\"umbrales\"][80],\n",
        "                        resultado_75[\"umbrales\"][90],\n",
        "                        resultado_75[\"umbrales\"][100],\n",
        "                        resultado_75[\"umbrales\"][110],\n",
        "                        resultado_75[\"umbrales\"][110],\n",
        "                    ]\n",
        "\n",
        "                    tabla = pd.DataFrame(\n",
        "                        {\n",
        "                            \"Zona\": zonas,\n",
        "                            \"%\": rangos,\n",
        "\n",
        "                            \"HR 0.5\": limites_50,\n",
        "                            \"segundos 0.5\": resultado_50[\"segundos\"],\n",
        "                            \"minutos 0.5\": resultado_50[\"minutos\"],\n",
        "\n",
        "                            \"HR 0.75\": limites_75,\n",
        "                            \"segundos 0.75\": resultado_75[\"segundos\"],\n",
        "                            \"minutos 0.75\": resultado_75[\"minutos\"],\n",
        "\n",
        "                            f\"RPE {parte}\": [\n",
        "                                informacion_parte[\"rpe\"],\n",
        "                                \"\",\n",
        "                                \"\",\n",
        "                                \"\",\n",
        "                                \"\",\n",
        "                                \"\",\n",
        "                            ],\n",
        "                        }\n",
        "                    )\n",
        "\n",
        "                    control.append(\n",
        "                        {\n",
        "                            \"Sesión\": sesion_rpe[\"numero\"],\n",
        "                            \"Fecha RPE\": sesion_rpe[\"fecha\"],\n",
        "                            \"Hoja HRV\": sesion_hrv[\"hoja\"],\n",
        "                            \"Fecha HRV\": sesion_hrv[\"fecha\"],\n",
        "                            \"Método\": metodo,\n",
        "                            \"Parte\": parte,\n",
        "\n",
        "                            \"Inicio solicitado\": segundos_a_hms(\n",
        "                                informacion_parte[\"inicio\"]\n",
        "                            ),\n",
        "\n",
        "                            \"Fin solicitado\": segundos_a_hms(\n",
        "                                informacion_parte[\"fin\"]\n",
        "                            ),\n",
        "\n",
        "                            \"Inicio usado\": segundos_a_hms(\n",
        "                                resultado_50[\"inicio_usado\"]\n",
        "                            ),\n",
        "\n",
        "                            \"Fin usado\": segundos_a_hms(\n",
        "                                resultado_50[\"fin_usado\"]\n",
        "                            ),\n",
        "\n",
        "                            \"Muestras\": resultado_50[\"muestras\"],\n",
        "\n",
        "                            \"Segundos Z1–Z6\": sum(\n",
        "                                resultado_50[\"segundos\"]\n",
        "                            ),\n",
        "\n",
        "                            \"Segundos <60%\": resultado_50[\"bajo60\"],\n",
        "\n",
        "                            \"Avisos\": \" | \".join(\n",
        "                                avisos\n",
        "                            ),\n",
        "                        }\n",
        "                    )\n",
        "\n",
        "                pd.DataFrame(\n",
        "                    [\n",
        "                        [\n",
        "                            f\"PARTE DE {parte}\"\n",
        "                        ]\n",
        "                    ]\n",
        "                ).to_excel(\n",
        "                    escritor,\n",
        "                    sheet_name=nombre_hoja,\n",
        "                    startrow=fila_inicio,\n",
        "                    index=False,\n",
