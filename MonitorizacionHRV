        "            \"Debe existir exactamente un Excel \"\n",
        "            \"de sesiones HRV. \"\n",
        "            f\"Encontrados: {candidatos_hrv}\"\n",
        "        )\n",
        "\n",
        "    return (\n",
        "        candidatos_hrv[0],\n",
        "        candidatos_rpe[0],\n",
